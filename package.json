{
  "name": "e2e-auto-test",
  "version": "0.1.0",
  "description": "通用可适配的 E2E 自动化测试框架，基于 Playwright 构建",
  "main": "dist/index.js",
  "bin": {
    "e2e-test": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": ["e2e", "playwright", "testing", "automation"],
  "license": "Apache-2.0",
  "dependencies": {
    "@playwright/test": "^1.52.0",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "cosmiconfig": "^9.0.0",
    "dotenv": "^16.4.0",
    "glob": "^11.0.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.86.0"
  }
}
